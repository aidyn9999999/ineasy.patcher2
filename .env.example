# Telegram Bot
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=ineasy_4k_bot
NEWS_CHANNEL_ID=@ineasynews
ADMIN_ID=
# Telegram bot video processing. Off by default; set to 1 on a powerful server. The site's V1/V2 modes always work.
SERVER_PROCESSING=0
# Local Telegram Bot API server (needed for videos > 20 MB, up to BOT_VIDEO_MAX_MB). Empty = cloud API.
BOT_API_ROOT=
BOT_VIDEO_MAX_MB=150
# Keep finished videos in this folder (e.g. on your laptop) instead of deleting them. Empty = delete.
BOT_VIDEO_KEEP_DIR=
BOT_VIDEO_CONCURRENCY=1
BOT_VIDEO_MAX_QUEUE=20
# From this queue position the bot adds a hint to process the video on the website instead.
BOT_VIDEO_SITE_HINT_AFTER=3

# Server
PORT=3000
SITE_URL=https://ineasy.site/app.html

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Direct TikTok publishing (Login Kit + Content Posting API). Visible to ADMIN_ID only; others keep using Zernio.
# Redirect URI to register in TikTok for Developers: https://ineasy.site/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MAX_UPLOAD_MB=1024
TIKTOK_MAX_SPOOL_MB=20480

# TikTok auto-publish via ShortSync (server environment only)
SHORTSYNC_API_KEY=ss_live_...
SHORTSYNC_CONNECTION_ID=con_...
