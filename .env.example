# Telegram Bot
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=ineasy_4k_bot
NEWS_CHANNEL_ID=@ineasynews
ADMIN_ID=
# Local Telegram Bot API server (needed for videos > 20 MB, up to BOT_VIDEO_MAX_MB). Empty = cloud API.
BOT_API_ROOT=
BOT_VIDEO_MAX_MB=150
# Keep finished videos in this folder (e.g. on your laptop) instead of deleting them. Empty = delete.
BOT_VIDEO_KEEP_DIR=
BOT_VIDEO_CONCURRENCY=1
BOT_VIDEO_MAX_QUEUE=20

# Server
PORT=3000
SITE_URL=https://ineasy.site/app.html

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# TikTok auto-publish via ShortSync (server environment only)
SHORTSYNC_API_KEY=ss_live_...
SHORTSYNC_CONNECTION_ID=con_...
